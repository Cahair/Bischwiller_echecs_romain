# Signature des cookies de session de l’espace admin (/admin).
# Générer une valeur avec : pnpm admin:secret
# 32 caractères minimum. La changer déconnecte tout le monde.
ADMIN_SESSION_SECRET=

# Mesure d'audience Umami (https://umami.is). Sans identifiant, rien n'est chargé.
# Identifiant du site : Umami → Paramètres → Sites web → Modifier.
# Lues au build : relancer `pnpm build` après les avoir changées.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Seulement pour une instance Umami auto-hébergée (sinon Umami Cloud) :
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://stats.exemple.fr/script.js

# Dossier où l’espace admin enregistre articles, photos, contenu à la une et
# comptes. En production : un chemin absolu HORS du dossier du site, pour que
# ni git pull ni un nouveau clone ne puissent y toucher. Laissé vide (en local),
# tout reste dans le projet : content/actualites/, public/media/actualites/…
# Au premier « npm run build », l’existant y est recopié automatiquement.
SITE_DATA_DIR=
